{
  "uid": "rentflow-overview",
  "title": "RentFlow overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "rentflow",
    "observability"
  ],
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "rentflow-prometheus"
        },
        "query": "label_values(process_uptime_seconds{service=\"rent-flow-inventory\"}, environment)",
        "refresh": 1,
        "current": {
          "text": "local",
          "value": "local"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Scrape health",
      "type": "timeseries",
      "description": "A zero means the target cannot be scraped. All three application management listeners are internal to Docker.",
      "datasource": {
        "type": "prometheus",
        "uid": "rentflow-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up",
          "legendFormat": "__auto",
          "exemplar": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "PostgreSQL availability",
      "type": "timeseries",
      "description": "Exporter connection health, separate from exporter scrape availability.",
      "datasource": {
        "type": "prometheus",
        "uid": "rentflow-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pg_up",
          "legendFormat": "__auto",
          "exemplar": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "Redis availability",
      "type": "timeseries",
      "description": "Redis is optional for Pricing readiness.",
      "datasource": {
        "type": "prometheus",
        "uid": "rentflow-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "redis_up",
          "legendFormat": "__auto",
          "exemplar": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "Kafka brokers",
      "type": "timeseries",
      "description": "Metadata-visible broker count. This is not broker JVM/JMX instrumentation.",
      "datasource": {
        "type": "prometheus",
        "uid": "rentflow-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kafka_brokers",
          "legendFormat": "__auto",
          "exemplar": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "title": "PostgreSQL connections",
      "type": "timeseries",
      "description": "Database activity from the pg_monitor role.",
      "datasource": {
        "type": "prometheus",
        "uid": "rentflow-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (datname, state) (pg_stat_activity_count)",
          "legendFormat": "__auto",
          "exemplar": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "Redis memory",
      "type": "timeseries",
      "description": "Cache resource use.",
      "datasource": {
        "type": "prometheus",
        "uid": "rentflow-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "redis_memory_used_bytes",
          "legendFormat": "__auto",
          "exemplar": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "title": "Consumer lag",
      "type": "timeseries",
      "description": "Partition lag summed per group/topic; retained topic and group labels are bounded by RentFlow exporter filters.",
      "datasource": {
        "type": "prometheus",
        "uid": "rentflow-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (consumergroup, topic) (clamp_min(kafka_consumergroup_lag, 0))",
          "legendFormat": "__auto",
          "exemplar": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "title": "Application HTTP requests",
      "type": "timeseries",
      "description": "Route templates; never raw URLs.",
      "datasource": {
        "type": "prometheus",
        "uid": "rentflow-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service,uri,status) (rate(http_server_requests_seconds_count{service=~\"rent-flow-(inventory|pricing|reservation)\",environment=\"$environment\"}[5m]))",
          "legendFormat": "__auto",
          "exemplar": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ]
}
