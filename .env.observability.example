# Copy to .env to enable the optional local stack and Inventory trace export.
COMPOSE_PROFILES=observability
TRACING_EXPORT_ENABLED=true
TRACING_SAMPLING_PROBABILITY=1.0
OBSERVABILITY_ENVIRONMENT=local
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=rentflow-local
OTLP_HTTP_PORT=4318
POSTGRES_EXPORTER_PASSWORD=monitoring-local
